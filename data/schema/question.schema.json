{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://python-mcq-trainer/question.schema.json",
  "title": "Python MCQ question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "chapter",
    "topic",
    "type",
    "difficulty",
    "source",
    "stem",
    "options",
    "correct",
    "explanation",
    "slides",
    "verify"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(S[1-8]-[0-9]{4}|PE-[0-9]{2}[a-z]?)$"
    },
    "chapter": {
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7",
        "S8"
      ]
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "enum": [
        "single",
        "multi"
      ]
    },
    "difficulty": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "source": {
      "enum": [
        "past_exam",
        "generated"
      ]
    },
    "stem": {
      "type": "string",
      "minLength": 5
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "mono": {
            "type": "boolean"
          },
          "out": {
            "type": [
              "string",
              "null"
            ]
          },
          "probe": {
            "type": "string"
          }
        }
      }
    },
    "correct": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-f]$"
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 10
    },
    "distractor_notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 319
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "output",
            "truth",
            "manual"
          ]
        },
        "code": {
          "type": "string"
        },
        "setup": {
          "type": "string"
        },
        "probe_template": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "prefix": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "expected_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "quirk": {
      "type": "boolean"
    },
    "quirk_note": {
      "type": "string"
    },
    "reconstructed": {
      "type": "boolean"
    },
    "reviewed": {
      "type": "integer",
      "minimum": 0
    },
    "past_exam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer"
        }
      },
      "required": [
        "page"
      ]
    }
  }
}
